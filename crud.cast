[27.649555, "o", "\u001b[?2004l\r\r\n"]
[27.727341, "o", "***База данных***\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n"]
[27.72737, "o", "<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[27.727424, "o", ">>>Введите команду: "]
[30.787439, "o", "create_table users name:str age:int is_active:bool"]
[31.073905, "o", "\r\n"]
[31.074752, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[31.075987, "o", ">>>Введите команду: "]
[33.681841, "o", "insert into users values (\"Gleb\", 22, true)"]
[34.014228, "o", "\r\n"]
[34.016199, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[34.01733, "o", ">>>Введите команду: "]
[39.169631, "o", "insert into users values (\"Anna\", 31, false)"]
[39.865262, "o", "\r\n"]
[39.866054, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[39.866982, "o", ">>>Введите команду: "]
[43.606072, "o", "select from users"]
[44.780835, "o", "\r\n"]
[44.857952, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 1  | Gleb |  22 |    True   |\r\n| 2  | Anna |  31 |   False   |\r\n+----+------+-----+-----------+\r\n"]
[44.858025, "o", ">>>Введите команду: "]
[49.779237, "o", "select from users where age = 22"]
[50.314218, "o", "\r\n"]
[50.315765, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 1  | Gleb |  22 |    True   |\r\n+----+------+-----+-----------+\r\n"]
[50.315928, "o", ">>>Введите команду: "]
[54.05057, "o", "update users set age = 23 where name = \"Gleb\""]
[54.386867, "o", "\r\n"]
[54.388751, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[54.388855, "o", ">>>Введите команду: "]
[57.274325, "o", "select from users"]
[57.686319, "o", "\r\n"]
[57.687464, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 1  | Gleb |  23 |    True   |\r\n| 2  | Anna |  31 |   False   |\r\n+----+------+-----+-----------+\r\n"]
[57.687685, "o", ">>>Введите команду: "]
[61.409669, "o", "delete from users where ID = 1"]
[61.896523, "o", "\r\n"]
[61.898645, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[61.898767, "o", ">>>Введите команду: "]
[66.696147, "o", "info users"]
[67.848147, "o", "\r\n"]
